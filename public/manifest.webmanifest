{
  "name": "reachloop",
  "short_name": "reachloop",
  "description": "Plan, caption and grow your photography Instagram.",
  "id": "/",
  "start_url": "/#create",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E0F10",
  "theme_color": "#151718",
  "categories": ["photo", "productivity", "social"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New post", "url": "/#create", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Plan", "url": "/#plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reels", "url": "/#reels", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "media", "accept": ["image/*", "video/*"] }] }
  }
}
